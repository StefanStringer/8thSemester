# Compiler and Flags
CXX = g++
CXXFLAGS = -O2 -std=c++20 -Wall -Wextra

# Files
SOURCES = main.cc spline.cc
OBJECTS = $(SOURCES:.cc=.o)
EXEC = main

# Default Target: Builds everything including plots
.PHONY: all clean

all: Out.txt fig_linear.svg fig_quadratic.svg fig_cubic.svg fig_total.svg

# Compilation rules
%.o: %.cc spline.hpp matrix.hpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(EXEC): $(OBJECTS)
	$(CXX) $(CXXFLAGS) $(OBJECTS) -o $@

# Run program: Generates Out.txt AND the .dat files
Out.txt: $(EXEC)
	./$(EXEC) > $@

# Ensure data files exist (they are generated by ./main in the step above)
linear.dat quadratic.dat cubic.dat: $(EXEC)
	./$(EXEC) >/dev/null 2>&1 || true

# --- Plotting Targets ---

fig_linear.svg: linear.dat
	@echo "Plotting linear..."
	echo 'set terminal svg size 800,600; \
	set output "fig_linear.svg"; \
	set xlabel "x"; set ylabel "cos(x)"; \
	set title "Linear Spline vs Exact"; \
	set grid; \
	plot "linear.dat" using 1:2 with lines title "Linear", \
	     cos(x) with lines lt 2 dt 2 title "Exact cos(x)";' | gnuplot

fig_quadratic.svg: quadratic.dat
	@echo "Plotting quadratic..."
	echo 'set terminal svg size 800,600; \
	set output "fig_quadratic.svg"; \
	set xlabel "x"; set ylabel "sin(x)"; \
	set title "Quadratic Spline vs Exact"; \
	set grid; \
	plot "quadratic.dat" using 1:2 with lines title "Quadratic", \
	     sin(x) with lines lt 2 dt 2 title "Exact sin(x)";' | gnuplot

# CRITICAL: Compares Cubic vs Gnuplot own feature
fig_cubic.svg: cubic.dat
	@echo "Plotting cubic (with Gnuplot comparison)..."
	echo 'set terminal svg size 800,600; \
	set output "fig_cubic.svg"; \
	set xlabel "x"; set ylabel "sin(x)"; \
	set title "Cubic Spline: Implementation vs Gnuplot"; \
	set grid; \
	plot "cubic.dat" using 1:2 with lines lw 2 title "Cubic", \
	     "cubic.dat" using 1:2 smooth cspline title "Gnuplot", \
	     sin(x) with lines lt 2 dt 2 title "Exact sin(x)";' | gnuplot

fig_total.svg: linear.dat quadratic.dat cubic.dat
	@echo "Plotting total comparison..."
	echo 'set terminal svg size 800,600; \
	set output "fig_total.svg"; \
	set xlabel "x"; set ylabel "f(x)"; \
	set title "All Splines Comparison"; \
	set grid; \
	plot "linear.dat" using 1:2 with lines lw 2 title "Linear", \
	     "quadratic.dat" using 1:2 with lines lw 2 title "Quadratic", \
	     "cubic.dat" using 1:2 with lines lw 2 title "Cubic", \
	     sin(x) with lines lt 2 dt 2 title "Exact sin(x)";' | gnuplot

# Clean up
clean:
	rm -f $(OBJECTS) $(EXEC) Out.txt linear.dat quadratic.dat cubic.dat *.svg